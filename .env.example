# 文字生成密钥——只有当你脱离编码 agent（Claude Code、Codex 等）、
# 想单独用 scripts/generate-content.mjs 批量重新生成文章时才需要，三选一：
# 在编码 agent 场景下通常不需要配置这几个，直接让当前 agent 写 content/*.mdx 即可。
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
# 任意 OpenAI 兼容 API（如 Qwen、GLM、Kimi、本地 vLLM 等），四选一：
# BASE_URL 填到版本前缀即可（通常含 /v1，如 https://dashscope.aliyuncs.com/compatible-mode/v1），
# 脚本会自动拼接 /chat/completions；也可直接填完整端点。
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=

# 配图，任选（对应 scripts/fetch-images.mjs 的 --provider 参数，这个通常还是需要的，
# 是图片检索/生成服务的 key，跟上面的文字模型 key 是两回事）
# 实拍图（推荐，更自然生动，免费商用）：
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
# AI生成图（适合抽象主题/插画风格，找不到合适实拍图时用）：
OPENAI_API_KEY=

# GitHub 自动建仓库 + 推送（scripts/push-to-github.mjs）：
# 需要 Personal Access Token：GitHub → Settings → Developer settings → Personal access tokens →
# Tokens (classic) 勾选 repo scope（或 fine-grained token 授予 Administration: write）。
# 只写在本机 .env.local（已被 .gitignore 忽略），不会提交到仓库。
GITHUB_TOKEN=

# Vercel 自动部署（可选，配合 scripts/push-to-github.mjs 的 B 方案）：
# 配置 VERCEL_TOKEN 后，push:github 会自动关联 Vercel 项目并把下面三个值写入 GitHub Actions secrets，
# 之后每次 push main 都自动构建部署，不需要再到 vercel.com 手动导入仓库。
# VERCEL_TOKEN：在 https://vercel.com/account/tokens 创建。
# VERCEL_ORG_ID / VERCEL_PROJECT_ID：可留空，脚本会自动跑 npx vercel link 生成；也可以手动填好以跳过 link。
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
